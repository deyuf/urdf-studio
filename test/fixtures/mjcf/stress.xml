<mujoco model="stress">
  <!-- Exercises the MJCF features the converter must get right; expected
       kinematics in stress.expected.json come from MuJoCo itself. -->
  <compiler angle="degree" eulerseq="zyx"/>
  <default>
    <joint axis="0 1 0" range="-90 90"/>
    <default class="slider">
      <joint type="slide" axis="1 0 0" range="-0.1 0.2"/>
    </default>
  </default>
  <asset>
    <material name="steel" rgba="0.6 0.62 0.65 1"/>
  </asset>
  <worldbody>
    <geom type="plane" size="0 0 1"/>
    <body name="base" pos="0 0 0.5" euler="10 20 30">
      <geom type="box" size="0.1 0.1 0.1" material="steel"/>
      <body name="two_joints" pos="0.2 0 0" xyaxes="0 1 0 -1 0 0">
        <joint name="j_a" pos="0.05 0 0" axis="0 0 1"/>
        <joint name="j_b" pos="0 0.03 0.01" axis="1 0 0" range="-30 45"/>
        <geom type="capsule" fromto="0 0 0 0.3 0 0" size="0.02" rgba="0.9 0.4 0.1 1"/>
        <frame pos="0.3 0 0" quat="0.7071068 0 0.7071068 0">
          <body name="in_frame" pos="0 0.1 0" zaxis="1 1 0">
            <joint name="j_c" class="slider"/>
            <geom type="cylinder" size="0.02 0.05"/>
            <body name="tip" axisangle="0 0 1 45" pos="0 0 0.1">
              <joint name="j_d" type="hinge" axis="1 1 0" limited="false"/>
              <geom type="sphere" size="0.02" group="3"/>
            </body>
          </body>
        </frame>
      </body>
    </body>
    <body name="ball_and_free" pos="1 0 0.2">
      <freejoint name="float"/>
      <geom type="ellipsoid" size="0.05 0.03 0.02" contype="0" conaffinity="0"/>
      <body name="socket" pos="0 0 0.1">
        <joint name="ball" type="ball" range="0 45"/>
        <geom type="sphere" size="0.01"/>
      </body>
    </body>
  </worldbody>
</mujoco>
